# LinguaDesk AI — environment variables
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# All keys here are placeholders only.

# Public URL of the app (local dev: http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL connection string (direct Postgres; optional if using Supabase only)
DATABASE_URL=postgresql://postgres:password@localhost:5432/linguadesk

# Supabase project (required for auth + database)
# Create a project at https://supabase.com/dashboard, then copy from Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI provider: "openai" (default) or "gemini" (free key from Google AI Studio)
AI_PROVIDER=openai

# OpenAI (Phase 4 AI features when AI_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini

# Gemini (Phase 4 AI features when AI_PROVIDER=gemini) — free key, no
# credit card, from https://aistudio.google.com/api-keys (create a Google
# Cloud project first if AI Studio cannot create one itself). Default
# model gemini-3.5-flash was verified working live 2026-11-11;
# gemini-3.8-flash timed out in that test, so it is not the default.
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.5-flash

# Google OAuth for Gmail integration (Phase 5; leave empty until then)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Microsoft OAuth for Outlook / Microsoft 365 integration (Phase 5; leave empty until then)
MICROSOFT_CLIENT_ID=your-microsoft-app-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-app-client-secret

# Token encryption for stored email OAuth tokens (Phase 5; required before
# any Gmail/Microsoft account can connect). 64 hex characters (32 bytes)
# OR 44 base64 characters (32 bytes). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER reuse a value from another project and never commit a real key.
TOKEN_ENCRYPTION_KEY=your-64-hex-character-encryption-key

# Provider API base URLs (Phase 5 test overrides only — leave unset in
# normal use; defaults are the real Gmail / Graph / OAuth endpoints)
# GMAIL_API_BASE_URL=https://gmail.googleapis.com/gmail/v1
# GRAPH_API_BASE_URL=https://graph.microsoft.com/v1.0
# GOOGLE_OAUTH_BASE_URL=https://oauth2.googleapis.com
# MICROSOFT_OAUTH_BASE_URL=https://login.microsoftonline.com
